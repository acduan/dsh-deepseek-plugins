{
  "name": "@local/dsh-rebuttal-settings-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Settings page for Rebuttal Mode: choose the critic and arbiter models from the current DSH model catalog.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
