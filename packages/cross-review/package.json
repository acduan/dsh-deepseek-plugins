{
  "name": "@local/dsh-cross-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-Verification Mode: adversarial review preset, reviewer/arbiter tools, and model settings page.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./preset": "./preset.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "preset.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
